# Database (Neon PostgreSQL)
DATABASE_URL=""

# Auth (NextAuth v5)
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Email (Resend)
RESEND_API_KEY=""

# Feature flags
# When unset: defaults to true in production, false in development.
# Set to "true" to require email verification on register and block sign-in until verified.
# Set to "false" to skip the verification email entirely and mark new users verified at signup.
EMAIL_VERIFICATION_ENABLED=""

# Rate limiting (Upstash Redis)
# When unset, auth endpoints are not rate-limited (fail-open).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
#Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

